              </div>

              <div class="folder-row">
                <span class="folder-dot"></span>
                Projects
              </div>

              <div class="folder-row">
                <span class="folder-dot"></span>
                Accounting
              </div>

              <div class="folder-row">
                <span class="folder-dot"></span>
                Photos
              </div>

              <div class="folder-row">
                <span class="folder-dot"></span>
                Archive
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>


    <!-- TRUST STRIP -->
    <section class="trust-strip">
      <div class="container">

        <div class="trust-grid">

          <div class="trust-item">
            <div class="trust-icon">⌕</div>
            <strong>Find What You Need</strong>
            <p>
              Logical folders, clearer names, and searchable information.
            </p>
          </div>

          <div class="trust-item">
            <div class="trust-icon">◷</div>
            <strong>Save Time</strong>
            <p>
              Spend less time searching through scattered files.
            </p>
          </div>

          <div class="trust-item">
            <div class="trust-icon">✓</div>
            <strong>Review Before Delete</strong>
            <p>
              Nothing is intentionally deleted without your review.
            </p>
          </div>

          <div class="trust-item">
            <div class="trust-icon">◆</div>
