<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Raw File Rescue | Austin, TX</title>

  <meta
    name="description"
    content="Raw File Rescue helps individuals and small businesses turn messy digital files, AI chats, data, and paper backlogs into organized digital archives."
  >

  <style>
    :root {
      --navy: #123b67;
      --navy-dark: #082b4c;
      --blue: #1976d2;
      --blue-hover: #1168bd;
      --orange: #f47a21;
      --orange-soft: #fff3e9;
      --charcoal: #252a2e;
      --muted: #5d6872;
      --off-white: #f8fafb;
      --pale-blue: #eef5fb;
      --border: #d9e3ec;
      --white: #ffffff;

      --shadow:
        0 8px 28px rgba(18, 59, 103, 0.08);

      --radius: 14px;
      --max-width: 1160px;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
      color: var(--charcoal);
      background: var(--white);
      line-height: 1.6;
    }

    img {
      max-width: 100%;
      display: block;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    h1,
    h2,
    h3,
    p {
      margin-top: 0;
    }

    h1,
    h2 {
      font-family:
        Georgia,
        "Times New Roman",
        serif;
    }

    .container {
      width: min(calc(100% - 40px), var(--max-width));
      margin-inline: auto;
    }

    .section {
      padding: 76px 0;
    }

    .section-alt {
      background: var(--off-white);
    }

    .section-blue {
      background: var(--pale-blue);
    }

    .section-heading {
      text-align: center;
      margin-bottom: 42px;
    }

    .section-heading h2 {
      margin-bottom: 8px;
      color: var(--navy);
      font-size: clamp(2rem, 4vw, 2.8rem);
      line-height: 1.1;
    }

    .section-heading p {
      max-width: 680px;
      margin: 0 auto;
      color: var(--muted);
      font-size: 1.05rem;
    }

    .accent-line {
      width: 52px;
      height: 4px;
      margin: 14px auto 0;
      border-radius: 100px;
      background: var(--orange);
    }

    /* HEADER */

    .site-header {
      position: sticky;
      top: 0;
      z-index: 1000;
      background: rgba(255, 255, 255, 0.96);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--border);
    }

    .nav {
      min-height: 78px;
      display: flex;
      align-items: center;
      gap: 28px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-right: auto;
    }

    .brand-icon {
      width: 46px;
      height: 36px;
      position: relative;
      border: 3px solid var(--navy);
      border-radius: 5px;
      background: white;
    }

    .brand-icon::before {
      content: "";
      position: absolute;
      width: 20px;
      height: 7px;
      top: -9px;
      left: 5px;
      border: 3px solid var(--navy);
      border-bottom: 0;
      border-radius: 5px 5px 0 0;
      background: white;
    }

    .brand-icon::after {
      content: "";
      position: absolute;
      width: 14px;
      height: 14px;
      right: 4px;
      bottom: 4px;
      border-radius: 50%;
      background: var(--orange);
    }

    .brand-name {
      color: var(--navy);
      font-size: 1.35rem;
      font-weight: 800;
      line-height: 1;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 26px;
      font-size: 0.96rem;
      font-weight: 650;
    }

    .nav-links a:hover {
      color: var(--blue);
    }

    .nav-contact {
      display: flex;
      align-items: center;
      gap: 8px;
      color: var(--navy);
      font-weight: 750;
      white-space: nowrap;
    }

    .phone-icon {
      color: var(--orange);
    }

    /* BUTTONS */

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 48px;
      padding: 0 24px;
      border-radius: 7px;
      border: 2px solid transparent;
      font-weight: 750;
      transition:
        transform 0.15s ease,
        background 0.15s ease;
      cursor: pointer;
    }

    .btn:hover {
      transform: translateY(-1px);
    }

    .btn-primary {
      color: white;
      background: var(--blue);
      box-shadow: 0 5px 16px rgba(25, 118, 210, 0.18);
    }

    .btn-primary:hover {
      background: var(--blue-hover);
    }

    .btn-outline {
      color: var(--navy);
      border-color: var(--blue);
      background: white;
    }

    .btn-outline:hover {
      background: var(--pale-blue);
    }

    /* HERO */

    .hero {
      padding: 72px 0 66px;
      overflow: hidden;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 0.95fr 1.05fr;
      gap: 56px;
      align-items: center;
    }

    .hero h1 {
      color: var(--navy-dark);
      font-size: clamp(2.8rem, 5.5vw, 4.8rem);
      line-height: 0.98;
      letter-spacing: -0.035em;
      margin-bottom: 26px;
    }

    .hero h1 .accent {
      color: var(--orange);
    }

    .hero-copy {
      color: var(--muted);
      font-size: 1.15rem;
      max-width: 620px;
      margin-bottom: 28px;
    }

    .hero-actions {
      display: flex;
      gap: 14px;
      flex-wrap: wrap;
    }

    /* HERO DEMO */

    .rescue-demo {
      position: relative;
      min-height: 410px;
      padding: 20px;
      border-radius: 22px;
      background:
        linear-gradient(
          135deg,
          #f4f7fa 0%,
          #ffffff 100%
        );
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
      align-items: stretch;
    }

    .demo-panel {
      border-radius: 14px;
      padding: 22px;
      position: relative;
      overflow: hidden;
    }

    .demo-before {
      background: #efe8dd;
    }

    .demo-after {
      background: #eaf4fc;
    }

    .demo-label {
      position: absolute;
      top: 14px;
      left: 14px;
      z-index: 2;
      padding: 5px 10px;
      border-radius: 100px;
      background: white;
      color: var(--navy);
      font-size: 0.72rem;
      font-weight: 850;
      box-shadow: 0 3px 10px rgba(0,0,0,0.08);
    }

    .paper-stack {
      padding-top: 55px;
    }

    .paper {
      height: 36px;
      margin: -4px auto 0;
      border: 1px solid #c6bba9;
      background: white;
      border-radius: 2px;
      box-shadow: 0 3px 8px rgba(0,0,0,0.06);
    }

    .paper:nth-child(1) {
      width: 90%;
      transform: rotate(-4deg);
    }

    .paper:nth-child(2) {
      width: 84%;
      transform: rotate(5deg);
    }

    .paper:nth-child(3) {
      width: 94%;
      transform: rotate(-2deg);
    }

    .paper:nth-child(4) {
      width: 78%;
      transform: rotate(7deg);
    }

    .paper:nth-child(5) {
      width: 92%;
      transform: rotate(-5deg);
    }

    .messy-files {
      margin-top: 28px;
      display: grid;
      gap: 7px;
    }

    .messy-files span {
      display: block;
      padding: 5px 7px;
      background: rgba(255,255,255,0.7);
      font-family: monospace;
      font-size: 0.67rem;
      color: #57504a;
    }

    .file-window {
      margin-top: 52px;
      background: white;
      border: 1px solid #ccd9e4;
      border-radius: 9px;
      box-shadow: 0 8px 22px rgba(18, 59, 103, 0.12);
      overflow: hidden;
    }

    .window-top {
      height: 27px;
      background: #f1f4f7;
      border-bottom: 1px solid #dde5ec;
    }

    .folder-row {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px 11px;
      border-bottom: 1px solid #eef1f3;
      font-size: 0.75rem;
    }

    .folder-dot {
      width: 18px;
      height: 13px;
      background: #5ba5dc;
      border-radius: 2px;
      flex: 0 0 auto;
    }

    .transform-arrow {
      position: absolute;
      z-index: 5;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      width: 54px;
      height: 54px;
      display: grid;
      place-items: center;
      border-radius: 50%;
      background: var(--orange);
      color: white;
      font-size: 1.7rem;
      font-weight: 900;
      box-shadow: 0 6px 18px rgba(244, 122, 33, 0.3);
    }

    /* TRUST STRIP */

    .trust-strip {
      padding: 0 0 54px;
    }

    .trust-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--pale-blue);
      overflow: hidden;
    }

    .trust-item {
      padding: 24px 25px;
    }

    .trust-item + .trust-item {
      border-left: 1px solid var(--border);
    }

    .trust-icon {
      color: var(--orange);
      font-size: 1.6rem;
      margin-bottom: 7px;
    }

    .trust-item strong {
      display: block;
      color: var(--navy);
      margin-bottom: 4px;
    }

    .trust-item p {
      color: var(--muted);
      margin: 0;
      font-size: 0.9rem;
    }

    /* SERVICES */

    .card-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
    }

    .service-card {
      padding: 30px;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: white;
      box-shadow: var(--shadow);
    }

    .service-icon {
      width: 50px;
      height: 50px;
      display: grid;
      place-items: center;
      margin-bottom: 18px;
      border-radius: 12px;
      background: var(--pale-blue);
      color: var(--navy);
      font-size: 1.5rem;
    }

    .service-card h3 {
      color: var(--navy);
      margin-bottom: 8px;
      font-size: 1.12rem;
    }

    .service-card p {
      color: var(--muted);
      margin-bottom: 0;
      font-size: 0.95rem;
    }

    /* BEFORE AFTER */

    .comparison-grid {
      display: grid;
      grid-template-columns: 1fr 90px 1fr;
      gap: 18px;
      align-items: center;
    }

    .comparison-box {
      min-height: 360px;
      padding: 28px;
      border-radius: var(--radius);
      background: white;
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
    }

    .comparison-box h3 {
      color: var(--navy);
      margin-bottom: 22px;
    }

    .comparison-list {
      padding: 0;
      margin: 0;
      list-style: none;
      display: grid;
      gap: 10px;
    }

    .comparison-list li {
      padding: 10px 12px;
      border-radius: 7px;
      background: var(--off-white);
      font-family: monospace;
      font-size: 0.82rem;
    }

    .organized-tree {
      display: grid;
      gap: 10px;
    }

    .tree-item {
      padding: 10px 12px;
      background: var(--pale-blue);
      border-radius: 7px;
      color: var(--navy);
      font-weight: 650;
    }

    .tree-item.sub {
      margin-left: 24px;
      background: var(--off-white);
      font-weight: 500;
    }

    .big-arrow {
      color: var(--orange);
      font-size: 3.5rem;
      text-align: center;
      font-weight: 900;
    }

    /* PRICING */

    .pricing-wrap {
      display: grid;
      grid-template-columns: 0.8fr 1.2fr;
      gap: 48px;
      align-items: center;
    }

    .price-card {
      padding: 36px;
      border-radius: var(--radius);
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
      background: white;
    }

    .price-label {
      color: var(--orange);
      font-weight: 850;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-size: 0.78rem;
    }

    .price {
      margin: 8px 0 10px;
      color: var(--navy);
      font-size: 3.2rem;
      line-height: 1;
      font-weight: 850;
    }

    .price span {
      font-size: 1rem;
      color: var(--muted);
      font-weight: 600;
    }

    .price-card p {
      color: var(--muted);
      margin-bottom: 0;
    }

    .pricing-copy h2 {
      color: var(--navy);
      font-size: clamp(2rem, 4vw, 2.8rem);
      margin-bottom: 15px;
    }

    .pricing-copy p {
      color: var(--muted);
    }

    .pricing-points {
      padding: 0;
      list-style: none;
      display: grid;
      gap: 12px;
      margin: 25px 0;
    }

    .pricing-points li::before {
      content: "✓";
      color: var(--orange);
      font-weight: 900;
      margin-right: 10px;
    }

    /* PROCESS */

    .steps {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 30px;
    }

    .step {
      position: relative;
      text-align: center;
    }

    .step-number {
      width: 42px;
      height: 42px;
      display: grid;
      place-items: center;
      margin: 0 auto 15px;
      border-radius: 50%;
      background: var(--blue);
      color: white;
      font-weight: 850;
    }

    .step:not(:last-child)::after {
      content: "→";
      position: absolute;
      right: -25px;
      top: 7px;
      color: var(--orange);
      font-size: 1.7rem;
    }

    .step h3 {
      color: var(--navy);
      margin-bottom: 6px;
    }

    .step p {
      color: var(--muted);
      font-size: 0.92rem;
      margin-bottom: 0;
    }

    /* REASSURANCE */

    .reassurance {
      margin-top: 50px;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      border-radius: var(--radius);
      overflow: hidden;
      border: 1px solid var(--border);
      background: white;
    }

    .reassurance-item {
      padding: 25px;
    }

    .reassurance-item + .reassurance-item {
      border-left: 1px solid var(--border);
    }

    .reassurance-item strong {
      color: var(--navy);
      display: block;
      margin-bottom: 4px;
    }

    .reassurance-item p {
      color: var(--muted);
      margin-bottom: 0;
      font-size: 0.9rem;
    }

    .orange-mark {
      color: var(--orange);
      margin-right: 7px;
    }

    /* CTA */

    .cta-section {
      padding: 34px 0 70px;
    }

    .cta-box {
      padding: 42px 46px;
      border-radius: 16px;
      background:
        linear-gradient(
          120deg,
          var(--navy-dark),
          #115ea4
        );
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 30px;
    }

    .cta-box h2 {
      margin: 0 0 6px;
      color: white;
      font-size: 2.3rem;
    }

    .cta-box p {
      margin: 0;
      color: #dfeefe;
    }

    .cta-box .btn {
      background: white;
      color: var(--blue);
      white-space: nowrap;
    }

    /* FOOTER */

    footer {
      padding: 52px 0 26px;
      color: #d7e3ed;
      background: var(--navy-dark);
    }

    .footer-grid {
      display: grid;
      grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
      gap: 40px;
    }

    footer .brand-name {
      color: white;
    }

    footer h4 {
      color: white;
      margin: 0 0 12px;
    }

    footer ul {
      padding: 0;
      margin: 0;
      list-style: none;
      display: grid;
      gap: 7px;
      font-size: 0.9rem;
    }

    footer a:hover {
      color: white;
    }

    .footer-contact {
      display: grid;
      gap: 8px;
      font-size: 0.92rem;
    }

    .footer-bottom {
      margin-top: 40px;
      padding-top: 22px;
      border-top: 1px solid rgba(255,255,255,0.15);
      color: #aebfce;
      font-size: 0.82rem;
      display: flex;
      justify-content: space-between;
      gap: 20px;
    }

    /* RESPONSIVE */

    @media (max-width: 980px) {
      .nav-links {
        display: none;
      }

      .hero-grid,
      .pricing-wrap {
        grid-template-columns: 1fr;
      }

      .hero h1 {
        max-width: 760px;
      }

      .card-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .trust-grid,
      .steps {
        grid-template-columns: repeat(2, 1fr);
      }

      .trust-item + .trust-item,
      .reassurance-item + .reassurance-item {
        border-left: 0;
      }

      .comparison-grid {
        grid-template-columns: 1fr;
      }

      .big-arrow {
        transform: rotate(90deg);
      }

      .footer-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .step:not(:last-child)::after {
        display: none;
      }
    }

    @media (max-width: 680px) {
      .container {
        width: min(calc(100% - 28px), var(--max-width));
      }

      .nav {
        min-height: 68px;
      }

      .nav-contact {
        display: none;
      }

      .brand-name {
        font-size: 1.08rem;
      }

      .hero {
        padding-top: 48px;
      }

      .hero-grid {
        gap: 38px;
      }

      .hero h1 {
        font-size: 2.65rem;
      }

      .rescue-demo {
        grid-template-columns: 1fr;
      }

      .transform-arrow {
        top: 50%;
        transform: translate(-50%, -50%) rotate(90deg);
      }

      .card-grid,
      .trust-grid,
      .steps,
      .reassurance,
      .footer-grid {
        grid-template-columns: 1fr;
      }

      .reassurance-item + .reassurance-item,
      .trust-item + .trust-item {
        border-top: 1px solid var(--border);
      }

      .cta-box {
        padding: 34px 26px;
        align-items: flex-start;
        flex-direction: column;
      }

      .footer-bottom {
        flex-direction: column;
      }
    }
  </style>
</head>

